DATABASE_URL=postgresql://finance_app:replace-me@db.example.internal:5432/finance
JWT_SECRET=replace-with-at-least-32-random-characters
FINANCE_GATEWAY_SECRET=replace-with-an-independent-32-character-secret
FINANCE_PROVIDER_CONTRACTS=[{"id":"paper-market","mode":"paper","contractRef":"agreement:replace-market","capabilities":["market-data"]},{"id":"paper-custody","mode":"paper","contractRef":"agreement:replace-custody","capabilities":["custody-snapshot","custody-reconciliation"]},{"id":"paper-broker","mode":"paper","contractRef":"agreement:replace-broker","capabilities":["paper-fill"]},{"id":"paper-actions","mode":"paper","contractRef":"agreement:replace-actions","capabilities":["corporate-action"]}]
CLIENT_URL=https://finance.example.com
REACT_APP_API_BASE_URL=https://api.finance.example.com/api
PORT=3002
NODE_ENV=production
ALPACA_KEY=set-only-after-provider-contract-approval
ALPACA_SECRET=set-only-after-provider-contract-approval
OPENROUTER_API_KEY=optional-and-not-authoritative-for-trading
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
